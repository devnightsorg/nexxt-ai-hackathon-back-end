# Copy to .env (npm run seed does this automatically and fills ADMIN_TOKEN). Never commit .env.
HOST=127.0.0.1
PORT=3100
# Bearer token for /admin and /admin/api (demo only)
ADMIN_TOKEN=
# mock = built-in fixtures (clearly labelled MOCK); http = teammates' banking backend
BANK_ADAPTER=mock
# Required when BANK_ADAPTER=http, e.g. http://127.0.0.1:3000/bank-agent
BANK_AGENT_URL=
# Allowed clock difference for signed requests, seconds
CLOCK_SKEW_SEC=60
# Optional: storage folder (default ./.data)
DATA_DIR=
