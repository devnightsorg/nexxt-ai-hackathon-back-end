# Copy to .env and fill in FEATHERLESS_API_KEY (fast model + embeddings) and, optionally,
# ANTHROPIC_API_KEY (main agent on Claude). Every other value below is the default from
# src/config/config.ts; docker compose overrides DATABASE_URL for the api container.
DATABASE_URL=postgresql://raiffeisen:raiffeisen@localhost:5433/raiffeisen
TEST_DATABASE_URL=postgresql://raiffeisen:raiffeisen@localhost:5433/raiffeisen_test
PORT=3000
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=2h
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
ANTHROPIC_API_KEY=
ANTHROPIC_AGENT_MODEL=claude-haiku-5-5
# anthropic | featherless; empty = anthropic when ANTHROPIC_API_KEY is set, else featherless
AGENT_PROVIDER=
# Featherless agent model (used when AGENT_PROVIDER=featherless)
AGENT_MODEL=Qwen/Qwen3-32B
FAST_MODEL=Qwen/Qwen3.8-27B
# Vectors are stored as vector(1024); the model must support `dimensions: 1024`.
# Changing it re-embeds the knowledge base on the next start.
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
AGENT_THINKING=false
AGENT_MAX_ITERATIONS=6
AGENT_TIMEOUT_MS=60000
FAST_TIMEOUT_MS=15000
EMBED_TIMEOUT_MS=30000
POLICY_MAX_PER_ACTION=50000
POLICY_DAILY_LIMIT=100000
ACTION_TTL_MINUTES=15
INTEREST_TAX_RATE=0.10
CORS_ORIGIN=*
KNOWLEDGE_DIR=seed/knowledge
SEED_ON_START=true
THROTTLE_LIMIT=120
AGENT_THROTTLE_LIMIT=20
